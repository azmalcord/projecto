# AORTIC EDU — HAIDER SCIENCE LAB
# Copy this file to .env and fill in values where required.

# Application runtime port (default 8080)
PORT=8080

# Public site URL used for canonical links, sitemap, and Open Graph
NEXT_PUBLIC_SITE_URL=https://aorticedu.example

# YouTube Data API v3 key (server-side only).
# Required for the automatic "Latest from HAIDER SCIENCE LAB" integration.
# Get one at https://console.cloud.google.com/
YOUTUBE_API_KEY=

# Optional: override the official channel handle used for latest-video resolution
# (defaults to @aorticedu_haidersciencelabs)
NEXT_PUBLIC_YOUTUBE_CHANNEL_HANDLE=@aorticedu_haidersciencelabs